# Coincide con los valores por defecto de docker-compose.yml (solo para desarrollo local)
DATABASE_URL=postgresql://hospital:hospital@localhost:5432/hospital_db
# Orígenes permitidos por CORS, separados por comas (opcional; por defecto el frontend local)
# CORS_ORIGINS=http://localhost:4200

# Secreto para firmar los tokens JWT (OBLIGATORIO, mínimo 32 caracteres).
# El valor de abajo es un ejemplo ficticio solo para desarrollo local: en cualquier otro entorno
# genera uno propio con:  python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=dev-only-change-me-0123456789abcdefghijklmnop
# Vigencia del token de acceso en minutos (opcional; por defecto 60)
# JWT_EXPIRE_MINUTES=60

# Contraseñas de las cuentas demo que crea `python -m app.seed` (opcionales; solo para el demo público)
# DEMO_ADMIN_PASSWORD=Admin-Demo-2026
# DEMO_PATIENT_PASSWORD=Paciente-Demo-2026
