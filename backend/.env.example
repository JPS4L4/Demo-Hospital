# Conexión a PostgreSQL (OBLIGATORIA). Coincide con los valores por defecto de docker-compose.yml
# (usuario, contraseña y base `hospital`/`hospital`/`hospital_db`, puerto 55432); solo para desarrollo
# local. Si cambias POSTGRES_USER, POSTGRES_PASSWORD, POSTGRES_DB o POSTGRES_PORT, cámbialos aquí también.
DATABASE_URL=postgresql://hospital:hospital@localhost:55432/hospital_db
# Orígenes permitidos por CORS, separados por comas (opcional; por defecto el frontend local)
# CORS_ORIGINS=http://localhost:4200

# Secreto para firmar los tokens JWT (OBLIGATORIO, mínimo 32 caracteres). El valor de abajo es solo un
# marcador: la API no arranca con él. Sustitúyelo por uno propio y no lo subas a git. Genéralo con:
#   cualquier sistema:      python -c "import secrets; print(secrets.token_urlsafe(48))"
#   Linux/macOS (bash):     openssl rand -base64 48 | tr '+/' '-_' | tr -d '=[:space:]'
#   Windows (PowerShell):   $b = New-Object byte[] 48; [Security.Cryptography.RandomNumberGenerator]::Create().GetBytes($b); [Convert]::ToBase64String($b).Replace('+','-').Replace('/','_')
JWT_SECRET=CAMBIA-ESTO-genera-un-secreto-de-al-menos-32-caracteres
# Vigencia del token de acceso en minutos (opcional; por defecto 60)
# JWT_EXPIRE_MINUTES=60

# Contraseñas de las cuentas demo que crea `python -m app.seed` (opcionales; solo para el demo público)
# DEMO_ADMIN_PASSWORD=Admin-Demo-2026
# DEMO_PATIENT_PASSWORD=Paciente-Demo-2026

# Reinicio periódico de la demo (opcional, DESACTIVADO por defecto). Con DEMO_RESET_ENABLED=true la API
# vacía TODAS las tablas de datos y vuelve a ejecutar el seed cada DEMO_RESET_INTERVAL_HORAS horas
# (mayor que 0; por defecto 6; el primer reinicio llega tras un intervalo, no al arrancar).
# Úsalo solo en el demo público: borra todo lo que se haya creado. Con varios workers solo uno reinicia.
# DEMO_RESET_ENABLED=false
# DEMO_RESET_INTERVAL_HORAS=6

# Nivel de registro: DEBUG, INFO, WARNING o ERROR (opcional; por defecto INFO)
# LOG_LEVEL=INFO

# Límite de intentos por IP y minuto (opcionales). RATE_LIMIT_ENABLED=false lo desactiva.
# RATE_LIMIT_ENABLED=true
# RATE_LIMIT_LOGIN_POR_MINUTO=10
# RATE_LIMIT_REGISTRO_POR_MINUTO=5
# Pon TRUSTED_PROXY=true solo si la API está detrás de un proxy de confianza que añade
# X-Forwarded-For; en otro caso la IP del cliente sería falsificable.
# TRUSTED_PROXY=false
